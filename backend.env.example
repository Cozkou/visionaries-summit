# Copy to .env.local and fill in values.

# Required in production — protects all /api/designs/* routes
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Optional in development (auth skipped if unset)
# NEXT_PUBLIC_INTERNAL_API_KEY=same-as-internal-api-key

# Staff login → returns API token (POST /api/auth/verify)
STAFF_PASSWORD=change-me

# DeepSeek — concepts + analysis text (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_TEXT_MODEL=deepseek-chat

# Product images: Unsplash CDN by default. Alt: IMAGE_SOURCE=loremflickr

# SQLite path (default: ./data/pretty-fly.db)
# DATABASE_PATH=./data/pretty-fly.db

# Ecommerce platform for the publish-to-site flow.
# - woocommerce: real Woo store (env vars below required)
# - mock: in-memory adapter, fully functional for local dev / demos
# Defaults to woocommerce if WOOCOMMERCE_* are set, otherwise falls back to mock.
COMMERCE_PROVIDER=mock

# WooCommerce REST API (https://woocommerce.github.io/woocommerce-rest-api-docs/)
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Shared secret used to verify incoming Woo webhooks (X-WC-Webhook-Signature)
WOOCOMMERCE_WEBHOOK_SECRET=
