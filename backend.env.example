# Copy to .env.local and fill in values.

# Required in production — protects all /api/designs/* routes
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Optional in development (auth skipped if unset)
# NEXT_PUBLIC_INTERNAL_API_KEY=same-as-internal-api-key

# Staff login -> returns API token (POST /api/auth/verify)
STAFF_PASSWORD=change-me

# Optional DeepSeek text client
# DEEPSEEK_API_KEY=

# Required for generated concept imagery.
# Preferred provider path:
# 1) ImageRouter OpenAI-compatible API
IMAGEROUTER_API_KEY=
# IMAGE_GENERATION_BASE_URL=https://api.imagerouter.io/v1/openai
# IMAGE_GENERATION_MODEL=openai/gpt-image-1.5
#
# 2) Direct OpenAI API
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1.5
#
# Backward-compatible aliases used by some existing image helpers:
# IMAGE_API_KEY=
# IMAGE_API_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=dall-e-3

# SQLite path (default: ./data/pretty-fly.db)
# DATABASE_PATH=./data/pretty-fly.db

# Optional Supabase project values
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional Supabase Postgres (direct or pooled, server-only)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_PROJECT_REF=[PROJECT-REF]

# Local dev: force SQLite when Postgres is unavailable
# USE_SQLITE=true

# Ecommerce: optional WooCommerce sync on publish.
# Without Woo credentials, publish creates a local /early-releases listing only.
# COMMERCE_PROVIDER=woocommerce

# WooCommerce REST API (https://woocommerce.github.io/woocommerce-rest-api-docs/)
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Shared secret used to verify incoming Woo webhooks (X-WC-Webhook-Signature)
WOOCOMMERCE_WEBHOOK_SECRET=
